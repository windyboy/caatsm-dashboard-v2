{
  "nodeModulesDir": "manual",
  "imports": {
    "$lib": "./src/lib",
    "$lib/*": "./src/lib/*",
    "@sveltejs/kit": "npm:@sveltejs/kit@2",
    "vite": "npm:vite@7",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@6",
    "unocss": "npm:unocss@66",
    "unocss/vite": "npm:unocss@66/vite"
  },
  "tasks": {
    "dev": "deno run -A npm:vite@7 dev",
    "build": "deno run -A npm:vite@7 build",
    "preview": "deno run -A npm:vite@7 preview",
    "check": "deno run -A npm:@sveltejs/kit@2 sync && deno check --allow-read --allow-write src/**/*.ts src/**/*.svelte",
    "dev:npm": "npm run dev",
    "build:npm": "npm run build",
    "preview:npm": "npm run preview"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "recommended": true
    }
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}

