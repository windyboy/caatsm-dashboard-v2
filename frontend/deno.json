{
  // Vite 7 + Svelte 5 config: Requires Node.js >=18
  // Migration guides:
  // - Vite 7: https://vite.dev/blog/announcing-vite7
  // - Svelte 5: https://svelte.dev/docs/svelte/v5-migration-guide
  // - Plugin v6: https://github.com/sveltejs/vite-plugin-svelte/blob/main/docs/config.md
  "nodeModulesDir": "manual",
  "imports": {
    "$lib": "./src/lib",
    "$lib/*": "./src/lib/*",
    "@sveltejs/kit": "npm:@sveltejs/kit@2.49.1",
    "vite": "npm:vite@7.2.6",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@6.2.1",
    "svelte": "npm:svelte@5.45.4",
    "unocss": "npm:unocss@66.5.10",
    "unocss/vite": "npm:unocss@66.5.10/vite"
  },
  "tasks": {
    "dev": "deno run -A deno-dev.ts",
    "build": "deno run -A npm:vite@7.2.6 build",
    "preview": "deno run -A npm:vite@7.2.6 preview",
    "check": "deno run -A npm:@sveltejs/kit@2.49.1 sync && deno check src/**/*.ts",
    "dev:npm": "npm run dev",
    "build:npm": "npm run build",
    "preview:npm": "npm run preview"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
