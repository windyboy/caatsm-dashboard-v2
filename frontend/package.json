{
  "name": "caatsm-dashboard-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@deno/svelte-adapter": "^0.1.0",
    "@playwright/test": "^1.57.0",
    "@sveltejs/kit": "^2.49.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/svelte": "^5.0.0",
    "@types/node": "^24.10.1",
    "@unocss/cli": "^66.5.10",
    "@unocss/preset-typography": "^66.5.10",
    "@unocss/preset-wind4": "^66.5.10",
    "@unocss/transformer-directives": "^66.5.10",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "axe-core": "^4.11.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.7.3",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.45.4",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "unocss": "^66.5.10",
    "vite": "^7.2.6",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@humanspeak/svelte-virtual-list": "^0.3.6",
    "@melt-ui/svelte": "^0.82.0",
    "chart.js": "^4.4.0",
    "isomorphic-dompurify": "^2.33.0",
    "web-vitals": "^5.1.0"
  }
}
