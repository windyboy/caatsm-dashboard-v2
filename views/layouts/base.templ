package layouts

// Base is the root layout for all pages.
templ Base(title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta http-equiv="X-UA-Compatible" content="IE=edge"/>
			<meta name="viewport" content="width=device-width,initial-scale=1"/>
			<title>{ title } · CAATSM Dashboard</title>
			<link rel="stylesheet" href="/css/app.css"/>
			<style>
				/* 背景样式 */
				body {
					background: linear-gradient(135deg, 
						rgb(238, 242, 247) 0%, 
						rgb(235, 239, 245) 50%, 
						rgb(237, 241, 246) 100%);
					background-attachment: fixed;
				}
				
				/* 消息组件颜色类 - 共享定义 */
				.bg-purple-50\/80 { background-color: rgba(250, 245, 255, 0.8); }
				.bg-purple-100\/90 { background-color: rgba(243, 232, 255, 0.9); }
				.text-purple-700 { color: rgb(126, 34, 206); }
				.group:hover .group-hover\:bg-purple-100\/90 { background-color: rgba(243, 232, 255, 0.9); }
				
				.bg-emerald-50\/80 { background-color: rgba(236, 253, 245, 0.8); }
				.bg-emerald-100\/90 { background-color: rgba(209, 250, 229, 0.9); }
				.text-emerald-700 { color: rgb(4, 120, 87); }
				.group:hover .group-hover\:bg-emerald-100\/90 { background-color: rgba(209, 250, 229, 0.9); }
				
				.bg-sky-50\/80 { background-color: rgba(240, 249, 255, 0.8); }
				.bg-sky-100\/90 { background-color: rgba(224, 242, 254, 0.9); }
				.text-sky-700 { color: rgb(3, 105, 161); }
				.group:hover .group-hover\:bg-sky-100\/90 { background-color: rgba(224, 242, 254, 0.9); }
				
				.bg-rose-50\/80 { background-color: rgba(255, 241, 242, 0.8); }
				.bg-rose-100\/90 { background-color: rgba(255, 228, 230, 0.9); }
				.text-rose-700 { color: rgb(190, 18, 60); }
				.group:hover .group-hover\:bg-rose-100\/90 { background-color: rgba(255, 228, 230, 0.9); }
				
				.bg-violet-50\/80 { background-color: rgba(245, 243, 255, 0.8); }
				.bg-violet-100\/90 { background-color: rgba(237, 233, 254, 0.9); }
				.text-violet-700 { color: rgb(109, 40, 217); }
				.group:hover .group-hover\:bg-violet-100\/90 { background-color: rgba(237, 233, 254, 0.9); }
				
				.bg-amber-50\/80 { background-color: rgba(255, 251, 235, 0.8); }
				.bg-amber-100\/90 { background-color: rgba(254, 243, 199, 0.9); }
				.text-amber-700 { color: rgb(180, 83, 9); }
				.group:hover .group-hover\:bg-amber-100\/90 { background-color: rgba(254, 243, 199, 0.9); }
				
				.bg-slate-50\/80 { background-color: rgba(248, 250, 252, 0.8); }
				.bg-slate-100\/80 { background-color: rgba(241, 245, 249, 0.8); }
				.bg-slate-200\/80 { background-color: rgba(226, 232, 240, 0.8); }
				.text-slate-500 { color: rgb(100, 116, 139); }
				.text-slate-600 { color: rgb(71, 85, 105); }
				.text-slate-700 { color: rgb(51, 65, 85); }
				.text-slate-800 { color: rgb(30, 41, 59); }
				.group:hover .group-hover\:bg-slate-200\/80 { background-color: rgba(226, 232, 240, 0.8); }
				.group:hover .group-hover\:text-slate-800 { color: rgb(30, 41, 59); }
				.group:hover .group-hover\:text-slate-700 { color: rgb(51, 65, 85); }
				
				/* Traffic Snapshot 类型统计颜色类 */
				.bg-sky-100\/80 { background-color: rgba(224, 242, 254, 0.8); }
				.group:hover .group-hover\:bg-sky-200\/80 { background-color: rgba(186, 230, 253, 0.8); }
				
				.bg-rose-100\/80 { background-color: rgba(255, 228, 230, 0.8); }
				.group:hover .group-hover\:bg-rose-200\/80 { background-color: rgba(254, 205, 211, 0.8); }
				
				.bg-emerald-100\/80 { background-color: rgba(209, 250, 229, 0.8); }
				.group:hover .group-hover\:bg-emerald-200\/80 { background-color: rgba(167, 243, 208, 0.8); }
				
				.bg-violet-100\/80 { background-color: rgba(237, 233, 254, 0.8); }
				.group:hover .group-hover\:bg-violet-200\/80 { background-color: rgba(221, 214, 254, 0.8); }
				
				.bg-amber-100\/80 { background-color: rgba(254, 243, 199, 0.8); }
				.group:hover .group-hover\:bg-amber-200\/80 { background-color: rgba(253, 230, 138, 0.8); }
				
				.bg-purple-100\/80 { background-color: rgba(243, 232, 255, 0.8); }
				.group:hover .group-hover\:bg-purple-200\/80 { background-color: rgba(233, 213, 255, 0.8); }
			</style>
		<script src="https://unpkg.com/htmx.org@2.0.0"></script>
		<script src="https://unpkg.com/htmx-ext-sse@2.2.2/sse.js"></script>
		<script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
	</head>
		<body class="min-h-screen text-slate-900 antialiased">

    <header class="bg-white/95 backdrop-blur-lg shadow-sm border-b border-slate-200/60 sticky top-0 z-50">
        <div class="mx-auto max-w-7xl px-6 py-5">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
					<div class="w-10 h-10 rounded-lg bg-gradient-to-br from-sky-500 to-blue-600 shadow-md border border-sky-600/20"></div>
					<h1 class="text-2xl font-bold text-slate-900 tracking-tight">
						CAATSM Dashboard
					</h1>
				</div>
				<nav class="flex items-center gap-2">
					<a href="/" class="px-4 py-2.5 text-sm font-semibold text-slate-700 hover:text-sky-600 hover:bg-sky-50/80 rounded-lg transition-all duration-200 border border-transparent hover:border-sky-200/60">
						Dashboard
					</a>
					<a href="/search" class="px-4 py-2.5 text-sm font-semibold text-slate-700 hover:text-sky-600 hover:bg-sky-50/80 rounded-lg transition-all duration-200 border border-transparent hover:border-sky-200/60">
						Search
					</a>
				</nav>
            </div>
        </div>
    </header>

    <main class="mx-auto max-w-7xl px-6 py-8">
        @content
    </main>
</body>

	</html>
}

