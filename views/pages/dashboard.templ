package pages

import (
	"github.com/windy/caatsm-dashboard/views/layouts"
)

// DashboardContent renders the dashboard content section.
templ DashboardContent() {
	<section class="space-y-6" hx-ext="sse" sse-connect="/api/stream">
		<div class="grid gap-6 lg:grid-cols-3">
			<div class="lg:col-span-2 rounded-xl border border-slate-800 bg-slate-900/40 p-6 shadow-lg">
				<div class="flex items-center justify-between mb-4">
					<div class="flex items-center gap-2">
						<div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
						<h2 class="text-lg font-medium text-slate-200">Live Stream</h2>
					</div>
					<span class="text-xs text-slate-500 bg-slate-800/50 px-2 py-1 rounded-md">Real-time updates</span>
				</div>
				<div class="h-96 overflow-y-auto rounded-lg border border-slate-800 bg-slate-950/60 p-4 space-y-3 scroll-smooth" 
					 id="live-stream" 
					 sse-swap="message"
					 hx-swap="afterbegin"
					 x-data="{ 
						scrollToTop() { 
							this.$nextTick(() => {
								this.$el.scrollTo({ top: 0, left: 0, behavior: 'smooth' });
							});
						}
					 }"
					 @htmx:after-swap="scrollToTop()"
					 @htmx:sse-message.window="if ($event.detail && $event.detail.event === 'message') { $nextTick(() => { scrollToTop(); }); }">
					<p class="text-sm text-slate-500 text-center py-8">Waiting for telegrams...</p>
				</div>
			</div>
			<div class="rounded-xl border border-slate-800 bg-slate-900/40 p-6 shadow-lg">
				<h2 class="mb-4 text-lg font-medium text-slate-200">Traffic Snapshot</h2>
				<div class="space-y-4">
					<div class="rounded-lg border border-slate-800 bg-slate-950/60 p-4">
						<p class="text-xs uppercase tracking-wider text-slate-500 mb-2">Total Messages (24h)</p>
						<div class="text-3xl font-semibold text-slate-100" 
							 sse-swap="stats-total"
							 hx-get="/api/stats/total" 
							 hx-trigger="load" 
							 hx-swap="innerHTML">--</div>
					</div>
					<div class="rounded-lg border border-slate-800 bg-slate-950/60 p-4">
						<p class="text-xs uppercase tracking-wider text-slate-500 mb-3">Priority Breakdown</p>
						<div class="space-y-2 text-sm text-slate-300" 
							 sse-swap="stats-priority"
							 hx-get="/api/stats/priority" 
							 hx-trigger="load" 
							 hx-swap="innerHTML">
							<p class="text-slate-500 text-center py-2">Loading...</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
}

// Dashboard renders the realtime overview page.
templ Dashboard() {
	@layouts.Base("Dashboard", DashboardContent())
}

