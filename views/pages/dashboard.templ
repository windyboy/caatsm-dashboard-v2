package pages

import (
	"github.com/windy/caatsm-dashboard/views/layouts"
)

// Dashboard renders the realtime overview page.
templ Dashboard() {
	@layouts.Base("Dashboard") {
		<section class="grid gap-6 md:grid-cols-2">
			<div class="rounded-xl border border-slate-800 bg-slate-900/40 p-6 shadow-lg">
				<h2 class="mb-4 text-lg font-medium text-slate-200">Live Stream</h2>
				<div class="h-72 overflow-y-auto rounded-lg border border-slate-800 bg-slate-950/60 p-4" id="live-stream" hx-ext="sse" sse-connect="/api/stream" sse-swap="message">
					<p class="text-sm text-slate-500">Waiting for telegrams...</p>
				</div>
			</div>
			<div class="rounded-xl border border-slate-800 bg-slate-900/40 p-6 shadow-lg">
				<h2 class="mb-4 text-lg font-medium text-slate-200">Traffic Snapshot</h2>
				<div class="grid gap-4">
					<div class="rounded-lg border border-slate-800 bg-slate-950/60 p-4">
						<p class="text-xs uppercase text-slate-500">Total Messages (24h)</p>
						<p class="mt-2 text-3xl font-semibold text-slate-100" hx-get="/api/stats/total" hx-trigger="load, every 30s" hx-target="this" hx-swap="innerHTML">--</p>
					</div>
					<div class="rounded-lg border border-slate-800 bg-slate-950/60 p-4">
						<p class="text-xs uppercase text-slate-500">Priority Breakdown</p>
						<div class="mt-3 space-y-2 text-sm text-slate-300" hx-get="/api/stats/priority" hx-trigger="load, every 45s" hx-target="this" hx-swap="innerHTML">
							<p>Loading...</p>
						</div>
					</div>
				</div>
			</div>
		</section>
	}
}

