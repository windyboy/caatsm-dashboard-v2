package pages

import (
	"github.com/windy/caatsm-dashboard/views/layouts"
)

// SearchContent renders the search interface content.
templ SearchContent() {
	<section class="space-y-6">
		<div class="rounded-xl border border-slate-800 bg-slate-900/40 p-6 shadow-lg">
			<form class="space-y-4" hx-post="/api/search" hx-target="#search-results" hx-swap="innerHTML">
				<div>
					<label class="text-sm font-medium text-slate-300" for="query">Keywords</label>
					<input id="query" name="query" type="search" placeholder="Flight number, message id, content..." class="mt-1 w-full rounded-lg border border-slate-800 bg-slate-950/70 px-4 py-2 text-slate-100 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/40" hx-get="/api/autocomplete" hx-trigger="keyup changed delay:500ms" hx-target="#autocomplete-results" hx-swap="innerHTML"/>
					<div id="autocomplete-results" class="mt-2 space-y-1 text-sm text-slate-400"></div>
				</div>
				<div class="grid gap-4 md:grid-cols-3">
					<div>
						<label class="text-xs uppercase text-slate-500">Type</label>
						<select name="type" class="mt-1 w-full rounded-lg border border-slate-800 bg-slate-950/70 px-3 py-2 text-sm text-slate-100">
							<option value="">Any</option>
							<option value="aftn">AFTN</option>
							<option value="sita">SITA</option>
							<option value="acars">ACARS</option>
							<option value="cpdlc">CPDLC</option>
						</select>
					</div>
					<div>
						<label class="text-xs uppercase text-slate-500">Priority</label>
						<select name="priority" class="mt-1 w-full rounded-lg border border-slate-800 bg-slate-950/70 px-3 py-2 text-sm text-slate-100">
							<option value="">Any</option>
							<option value="1">Urgent</option>
							<option value="2">Operational</option>
							<option value="3">Routine</option>
						</select>
					</div>
					<div>
						<label class="text-xs uppercase text-slate-500">Time Range</label>
						<input type="text" name="time_range" placeholder="Last 24h" class="mt-1 w-full rounded-lg border border-slate-800 bg-slate-950/70 px-3 py-2 text-sm text-slate-100"/>
					</div>
				</div>
				<div class="flex justify-end gap-3">
					<button type="button" class="rounded-lg border border-slate-700 px-4 py-2 text-sm text-slate-300 hover:bg-slate-800/60" hx-get="/search" hx-target="body">Reset</button>
					<button type="submit" class="rounded-lg bg-sky-500 px-4 py-2 text-sm font-medium text-slate-900 hover:bg-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-500/40">Search</button>
				</div>
			</form>
		</div>
		<div id="search-results" class="rounded-xl border border-slate-800 bg-slate-900/40 p-6 shadow-lg">
			<p class="text-sm text-slate-400">Use the filters above to search the telegram archive.</p>
		</div>
	</section>
}

// Search renders the search interface using HTMX powered filters.
templ Search() {
	@layouts.Base("Search", SearchContent())
}

