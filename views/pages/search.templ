package pages

import (
	"github.com/windy/caatsm-dashboard/views/layouts"
)

// SearchContent renders the search interface content.
templ SearchContent() {
	<style>
		/* 消息组件颜色类 - 直接定义确保生效 */
		.bg-purple-50\/80 { background-color: rgba(250, 245, 255, 0.8) !important; }
		.bg-purple-100\/90 { background-color: rgba(243, 232, 255, 0.9) !important; }
		.text-purple-700 { color: rgb(126, 34, 206) !important; }
		.group:hover .group-hover\:bg-purple-100\/90 { background-color: rgba(243, 232, 255, 0.9) !important; }
		
		.bg-emerald-50\/80 { background-color: rgba(236, 253, 245, 0.8) !important; }
		.bg-emerald-100\/90 { background-color: rgba(209, 250, 229, 0.9) !important; }
		.text-emerald-700 { color: rgb(4, 120, 87) !important; }
		.group:hover .group-hover\:bg-emerald-100\/90 { background-color: rgba(209, 250, 229, 0.9) !important; }
		
		.bg-sky-50\/80 { background-color: rgba(240, 249, 255, 0.8) !important; }
		.bg-sky-100\/90 { background-color: rgba(224, 242, 254, 0.9) !important; }
		.text-sky-700 { color: rgb(3, 105, 161) !important; }
		.group:hover .group-hover\:bg-sky-100\/90 { background-color: rgba(224, 242, 254, 0.9) !important; }
		
		.bg-rose-50\/80 { background-color: rgba(255, 241, 242, 0.8) !important; }
		.bg-rose-100\/90 { background-color: rgba(255, 228, 230, 0.9) !important; }
		.text-rose-700 { color: rgb(190, 18, 60) !important; }
		.group:hover .group-hover\:bg-rose-100\/90 { background-color: rgba(255, 228, 230, 0.9) !important; }
		
		.bg-violet-50\/80 { background-color: rgba(245, 243, 255, 0.8) !important; }
		.bg-violet-100\/90 { background-color: rgba(237, 233, 254, 0.9) !important; }
		.text-violet-700 { color: rgb(109, 40, 217) !important; }
		.group:hover .group-hover\:bg-violet-100\/90 { background-color: rgba(237, 233, 254, 0.9) !important; }
		
		.bg-amber-50\/80 { background-color: rgba(255, 251, 235, 0.8) !important; }
		.bg-amber-100\/90 { background-color: rgba(254, 243, 199, 0.9) !important; }
		.text-amber-700 { color: rgb(180, 83, 9) !important; }
		.group:hover .group-hover\:bg-amber-100\/90 { background-color: rgba(254, 243, 199, 0.9) !important; }
		
		.bg-slate-50\/80 { background-color: rgba(248, 250, 252, 0.8) !important; }
		.bg-slate-100\/80 { background-color: rgba(241, 245, 249, 0.8) !important; }
		.bg-slate-200\/80 { background-color: rgba(226, 232, 240, 0.8) !important; }
		.text-slate-500 { color: rgb(100, 116, 139) !important; }
		.text-slate-600 { color: rgb(71, 85, 105) !important; }
		.text-slate-700 { color: rgb(51, 65, 85) !important; }
		.text-slate-800 { color: rgb(30, 41, 59) !important; }
		.group:hover .group-hover\:bg-slate-200\/80 { background-color: rgba(226, 232, 240, 0.8) !important; }
		.group:hover .group-hover\:text-slate-800 { color: rgb(30, 41, 59) !important; }
		.group:hover .group-hover\:text-slate-700 { color: rgb(51, 65, 85) !important; }
	</style>
	<section class="space-y-8">
		<div class="rounded-lg bg-white/90 backdrop-blur-sm border-0 p-8 card-glow">
			<div class="mb-6 pb-4 border-b border-slate-200/60">
				<h2 class="text-xl font-bold text-slate-800 tracking-tight">Search Telegrams</h2>
			</div>
			<form class="space-y-6" hx-post="/api/search" hx-target="#search-results" hx-swap="innerHTML">
				<div>
					<label class="block text-sm font-semibold text-slate-700 mb-2.5" for="query">Keywords</label>
					<input id="query" name="query" type="search" placeholder="Flight number, message id, content..." 
					       class="w-full rounded-lg bg-slate-100/50 px-5 py-3 text-slate-900 border-0 
					              placeholder:text-slate-400 focus:bg-white/95 focus:outline-none focus:ring-2 focus:ring-sky-500/30 focus:shadow-md
					              transition-all duration-200 shadow-sm" 
					       hx-get="/api/autocomplete" hx-trigger="keyup changed delay:500ms" hx-target="#autocomplete-results" hx-swap="innerHTML"/>
					<div id="autocomplete-results" class="mt-2"></div>
				</div>
				<div class="grid gap-5 md:grid-cols-3">
					<div>
						<label class="block text-xs uppercase tracking-widest text-slate-600 mb-2.5 font-bold">Type</label>
						<select name="type" class="w-full rounded-lg bg-slate-100/50 px-4 py-3 text-sm text-slate-900 border-0 
						        focus:bg-white/95 focus:outline-none focus:ring-2 focus:ring-sky-500/30 focus:shadow-md transition-all duration-200 shadow-sm">
							<option value="">Any</option>
							<option value="aftn">AFTN</option>
							<option value="sita">SITA</option>
							<option value="acars">ACARS</option>
							<option value="cpdlc">CPDLC</option>
						</select>
					</div>
					<div>
						<label class="block text-xs uppercase tracking-widest text-slate-600 mb-2.5 font-bold">Priority</label>
						<select name="priority" class="w-full rounded-lg bg-slate-100/50 px-4 py-3 text-sm text-slate-900 border-0 
						        focus:bg-white/95 focus:outline-none focus:ring-2 focus:ring-sky-500/30 focus:shadow-md transition-all duration-200 shadow-sm">
							<option value="">Any</option>
							<option value="1">Urgent</option>
							<option value="2">Operational</option>
							<option value="3">Routine</option>
						</select>
					</div>
					<div>
						<label class="block text-xs uppercase tracking-widest text-slate-600 mb-2.5 font-bold">Time Range</label>
						<input type="text" name="time_range" placeholder="Last 24h" 
						       class="w-full rounded-lg bg-slate-100/50 px-4 py-3 text-sm text-slate-900 border-0 
						              placeholder:text-slate-400 focus:bg-white/95 focus:outline-none focus:ring-2 focus:ring-sky-500/30 focus:shadow-md
						              transition-all duration-200 shadow-sm"/>
					</div>
				</div>
				<div class="flex justify-end gap-3 pt-4 border-t border-slate-200/60">
					<button type="button" class="rounded-lg bg-slate-100/80 px-6 py-2.5 text-sm font-semibold text-slate-700 
					        hover:bg-slate-200/90 transition-all duration-200 shadow-sm hover:shadow border-0" 
					        hx-get="/search" hx-target="body">Reset</button>
					<button type="submit" class="rounded-lg bg-sky-500 px-6 py-2.5 text-sm font-semibold text-white 
					        hover:bg-sky-600 focus:outline-none focus:ring-2 focus:ring-sky-500/40 
					        transition-all duration-200 shadow-md hover:shadow-lg">Search</button>
				</div>
			</form>
		</div>
		<div id="search-results" class="rounded-lg bg-white/90 backdrop-blur-sm border-0 p-8 card-glow min-h-[400px]">
			<div class="flex flex-col items-center justify-center gap-2 text-slate-400 py-12">
				<p class="text-sm font-medium text-slate-500">Use the filters above to search the telegram archive.</p>
			</div>
		</div>
	</section>
}

// Search renders the search interface using HTMX powered filters.
templ Search() {
	@layouts.Base("Search", SearchContent())
}

