package components

import "fmt"

templ StatsType(byType map[string]int64) {
	<div class="space-y-2.5">
		if len(byType) > 0 {
			for msgType, count := range byType {
				<div class="group flex items-center justify-between p-3 rounded-lg bg-gradient-to-r from-slate-50/50 to-white/80 hover:from-slate-100/60 hover:to-white transition-all duration-200 border-0 shadow-sm hover:shadow">
					<div class="flex items-center gap-3">
						<div class={ fmt.Sprintf(
							"flex items-center justify-center w-8 h-8 rounded-md border-0 shadow-sm transition-colors "+
								"bg-%s-100/80 group-hover:bg-%s-200/80",
							typeColor(msgType), typeColor(msgType),
						)}>
							<span class={ fmt.Sprintf("text-xs font-bold text-%s-700", typeColor(msgType)) }>
								{ msgType }
							</span>
						</div>
						<span class="text-sm font-medium text-slate-700 group-hover:text-slate-900 transition-colors">
							{ msgType }
						</span>
					</div>
					<span class="text-base font-bold text-slate-900 bg-white/90 px-3 py-1.5 rounded-md border-0 shadow-sm transition-colors min-w-[3.5rem] text-center">
						{ fmt.Sprintf("%d", count) }
					</span>
				</div>
			}
		} else {
			<div class="text-center py-8 rounded-lg bg-slate-100/40 border border-dashed border-slate-300/40">
				<p class="text-sm text-slate-500 font-medium">No data available</p>
			</div>
		}
	</div>
}

