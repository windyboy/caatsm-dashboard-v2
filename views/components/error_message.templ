package components

templ ErrorMessage(message string) {
	<div class="flex items-center gap-3 p-4 rounded-lg border border-red-200/60 bg-red-50/60 backdrop-blur-sm shadow-sm">
		<div class="flex-shrink-0 w-1.5 h-1.5 rounded-full bg-red-500"></div>
		<p class="text-sm font-semibold text-red-800 flex-1">{ message }</p>
	</div>
}

