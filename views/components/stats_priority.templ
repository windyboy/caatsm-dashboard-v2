package components

import "fmt"

templ StatsPriority(byPriority map[int]int64) {
	<div class="space-y-2">
		if len(byPriority) > 0 {
			for priority, count := range byPriority {
				<div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-800/30 hover:bg-slate-800/50 transition-colors border border-slate-700/30">
					<div class="flex items-center gap-2.5">
						<div class="flex items-center justify-center w-7 h-7 rounded-md bg-gradient-to-br from-purple-500/20 to-purple-600/20 border border-purple-500/30">
							<span class="text-xs font-bold text-purple-300">{ fmt.Sprintf("%d", priority) }</span>
						</div>
						<span class="text-sm font-medium text-slate-300">Priority { fmt.Sprintf("%d", priority) }</span>
					</div>
					<span class="text-sm font-semibold text-slate-100 bg-slate-700/50 px-2.5 py-1 rounded-md">{ fmt.Sprintf("%d", count) }</span>
				</div>
			}
		} else {
			<div class="text-center py-4">
				<p class="text-sm text-slate-500">No data</p>
			</div>
		}
	</div>
}

