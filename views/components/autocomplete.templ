package components

templ Autocomplete(suggestions []string) {
	if len(suggestions) > 0 {
		<div class="mt-2 rounded-lg bg-white/95 backdrop-blur-sm border-0 shadow-xl overflow-hidden divide-y divide-slate-200/40">
		for _, suggestion := range suggestions {
				<div class="cursor-pointer px-5 py-3 text-sm text-slate-700 hover:bg-sky-50/80 hover:text-sky-700 transition-all duration-200 flex items-center gap-3 group">
					<span class="font-medium">{ suggestion }</span>
				</div>
		}
		</div>
	}
}

