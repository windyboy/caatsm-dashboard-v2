package components

import (
	"fmt"
	"github.com/windy/caatsm-dashboard/internal/models"
)

templ SearchResults(telegrams []models.Telegram, total int64) {
	<div class="space-y-5">
		<p class="text-base font-semibold text-slate-700 mb-5">
			Found <span class="text-sky-600 font-bold">{ fmt.Sprintf("%d", total) }</span> results
		</p>
		if len(telegrams) > 0 {
			<div class="space-y-4">
				for _, t := range telegrams {
					<div class="group rounded-lg bg-white/95 border-0
					            p-5 message-card-glow
					            hover:bg-white/98 transition-all duration-200">
						
						<!-- Header -->
						<div class="flex justify-between items-start mb-4">
							<div class="flex-1 min-w-0">
								<div class="flex items-center gap-3 mb-2">
									<!-- Message ID -->
									<span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold
									             bg-slate-100/80 text-slate-800 border-0 shadow-sm
									             group-hover:bg-slate-200/80 transition-colors">
										{ t.MessageID }
									</span>
									
									<!-- Flight Number -->
									if t.FlightNumber != "" {
										<span class="text-xs text-slate-600 font-semibold group-hover:text-slate-800 transition-colors">
											{ t.FlightNumber }
										</span>
									}
								</div>
							</div>
							
							<!-- Time -->
							<span class="text-xs text-slate-500 whitespace-nowrap ml-3 font-mono font-medium
							            group-hover:text-slate-700 transition-colors bg-slate-50/80 px-2.5 py-1 rounded-md border-0 shadow-sm">
								{ t.Time.Format("2006-01-02 15:04:05") }
							</span>
						</div>
						
						<!-- Message Content -->
						<p class="text-sm text-slate-800 mb-3 break-words leading-relaxed">
							{ t.Content }
						</p>
						
						<!-- Tags -->
						<div class="flex flex-wrap gap-2">
							<!-- Type Tag -->
							<span class={ fmt.Sprintf(
								"inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium shadow-sm border-0 "+
									"bg-%s-50/80 text-%s-700 group-hover:bg-%s-100/90 transition-colors", 
								typeColor(t.Type), typeColor(t.Type), 
								typeColor(t.Type),
							)}>
								{ t.Type }
							</span>
							
							<!-- Priority -->
							<span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium shadow-sm border-0
							             bg-purple-50/80 text-purple-700
							             group-hover:bg-purple-100/90 transition-colors">
								Priority { fmt.Sprintf("%d", t.Priority) }
							</span>
							
							<!-- Route -->
							if t.Source != "" && t.Destination != "" {
								<span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium shadow-sm border-0
								             bg-emerald-50/80 text-emerald-700
								             group-hover:bg-emerald-100/90 transition-colors">
									{ t.Source } → { t.Destination }
								</span>
							}
						</div>
					</div>
				}
			</div>
		} else {
			<div class="text-center py-12 rounded-lg bg-slate-100/40 border border-dashed border-slate-300/40">
				<p class="text-sm font-semibold text-slate-500 mb-1">No results found</p>
				<p class="text-xs text-slate-400">Try adjusting your search criteria</p>
			</div>
		}
	</div>
}

