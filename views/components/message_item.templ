package components

import (
	"fmt"
	"github.com/windy/caatsm-dashboard/internal/models"
)

templ MessageItem(telegram models.Telegram) {
	<div class="group rounded-lg border border-slate-700/50 bg-gradient-to-br from-slate-900/60 to-slate-900/40 p-4 hover:border-slate-600 hover:shadow-md transition-all duration-200">
		<div class="flex justify-between items-start mb-3">
			<div class="flex-1 min-w-0">
				<div class="flex items-center gap-2 mb-1">
					<span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-sky-500/20 text-sky-300 border border-sky-500/30">
						{ telegram.MessageID }
					</span>
					if telegram.FlightNumber != "" {
						<span class="text-xs text-slate-400 font-medium">{ telegram.FlightNumber }</span>
					}
				</div>
			</div>
			<span class="text-xs text-slate-500 whitespace-nowrap ml-2 font-mono">{ telegram.Time.Format("15:04:05") }</span>
		</div>
		<p class="text-sm text-slate-200 mb-3 break-words leading-relaxed">{ telegram.Content }</p>
		<div class="flex flex-wrap gap-2">
			<span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-blue-500/20 text-blue-300 border border-blue-500/30">
				{ telegram.Type }
			</span>
			<span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-purple-500/20 text-purple-300 border border-purple-500/30">
				Priority { fmt.Sprintf("%d", telegram.Priority) }
			</span>
			if telegram.Source != "" && telegram.Destination != "" {
				<span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
					{ telegram.Source } → { telegram.Destination }
				</span>
			}
		</div>
	</div>
}

