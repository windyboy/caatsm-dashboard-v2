package components

import "fmt"

templ StatsTotal(count int64) {
	<div class="flex items-baseline gap-3">
		<span class="text-3xl font-bold bg-gradient-to-r from-sky-600 via-blue-600 to-indigo-600 bg-clip-text text-transparent">
				{ fmt.Sprintf("%d", count) }
			</span>
		<span class="text-sm text-slate-600 font-medium">messages</span>
	</div>
}

