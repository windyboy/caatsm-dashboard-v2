# Local development environment variables
# Copy this file to .env.local and update with your values
# Note: .env.local is gitignored and won't be committed

# Application environment
CAATSM_ENVIRONMENT=development

# Server
CAATSM_SERVER_HOST=0.0.0.0
CAATSM_SERVER_PORT=3002

# Database
CAATSM_DATABASE_DSN=postgres://caatsm:caatsm@localhost:5432/caatsm?sslmode=disable

# Meilisearch
# If Meilisearch generates a new master key, update this value
# You can find it in the Meilisearch container logs:
# docker compose -f docker-compose.dev.yml logs meilisearch | grep "master key"
# Or: podman compose -f docker-compose.dev.yml logs meilisearch | grep "master key"
CAATSM_MEILISEARCH_HOST=http://localhost:7700
CAATSM_MEILISEARCH_API_KEY=masterKey

# Redis
CAATSM_REDIS_ADDR=localhost:6379

# NATS
CAATSM_NATS_URL=nats://localhost:4222

# Auth (optional for local development)
CAATSM_AUTH_USERNAME=admin
CAATSM_AUTH_PASSWORD=dev-password
CAATSM_AUTH_JWT_SECRET=dev-jwt-secret-change-me

