{
  "name": "caatsm-dashboard",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "unocss:dev": "unocss \"views/**/*.templ\" \"assets/css/**/*.css\" --watch -o ./public/css/app.css",
    "unocss:build": "unocss \"views/**/*.templ\" \"assets/css/**/*.css\" -o ./public/css/app.css --minify"
  },
  "devDependencies": {
    "@unocss/preset-typography": "latest",
    "@unocss/preset-wind3": "latest",
    "@unocss/transformer-directives": "latest",
    "unocss": "latest"
  },
  "dependencies": {
    "@unocss/reset": "^66.5.6"
  }
}
